# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# 数据库连接（通过 webnet 网络直连 PG 容器）
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-server:5432/semgravio
SPRING_DATASOURCE_USERNAME=hcy_pgsql
SPRING_DATASOURCE_PASSWORD=hcy_admin_pgsql

# Redis（通过 webnet 网络直连已有 Redis 容器；REDIS_HOST / REDIS_PASSWORD 均无默认值，
# 缺了启动 fail-fast——#383 起 prod 配置面带 requirepass 密码项）
REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenAPI 签名
OPENAPI_APP_ID=
OPENAPI_APP_SECRET=

# 服务器部署（publish.sh 使用）
SERVER_PASSWORD=Hcy@20260327
