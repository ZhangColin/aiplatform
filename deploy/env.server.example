# aiplatform-server 生产环境变量模板
# 复制到 aiplatform-server/.env.production 并填值（密钥类从开发机 aiplatform-server/.env.local 取）。
# 完整变量口径见 aiplatform-server/docs/guide/生产部署.md §7；本模板按「首部署不接
# SSO/backoffice」口径裁剪（SSO_* / OPENAPI_* 不配，后端照常起）。

SPRING_PROFILES_ACTIVE=prod

# 数据库（infra compose 的 PG 容器；密码与 deploy/.env 的 POSTGRES_PASSWORD 同值）
SPRING_DATASOURCE_URL=jdbc:postgresql://aiplatform-postgres:5432/aiplatform
SPRING_DATASOURCE_USERNAME=aiplatform
SPRING_DATASOURCE_PASSWORD=<与 deploy/.env 的 POSTGRES_PASSWORD 同值>

# Redis（prod 配置 REDIS_HOST 无默认值，缺了起不来）
REDIS_HOST=aiplatform-redis
REDIS_PORT=6379

# embedding（infra compose 的 embedding 容器）
EMBEDDING_URL=http://aiplatform-embedding:9091

# 预览基域。无端口＝预览走 80；非标端口形态写 preview.<域名>:8080。
# 无域名部署用 sslip.io：<IP 划线形>.sslip.io，见部署文档 §10。
PREVIEW_BASE=preview.<域名>

# ↓ http 形态的两个覆盖（环境变量优先级高于 jar 内 prod 配置——prod 烤死 https/true，
#   是 https+域名形态的值）。IP 直访或未备案域名必须带这两行，否则预览 URL 是 https://
#   且访客 cookie 带 Secure 标志被浏览器拒收（http 下存不住、会话丢）。
APP_WORKSPACE_PREVIEW_SCHEME=http
SSO_COOKIE_SECURE=false
# ↑ 转 https（备案域名或海外机＋证书）时删掉这两行。

# 模型通道 key（⚠ 首启 Flyway V44 迁移时必须在场——种进 prj_model_providers，
# 库为唯一正本；缺了服务照常起、首次模型装配才响亮报错）
VOLCENGINE_API_KEY=<开发机 .env.local>
DEEPSEEK_API_KEY=<可选，备胎通道>

# 外部资料搜索
BOCHA_API_KEY=<开发机 .env.local>

# 出图选型（provider 名与对应 key 从开发机 .env.local 取）
IMAGE_GEN_PROVIDER=<volcano / zhipu / openai / dashscope>
ARK_API_KEY=<volcano 时>
